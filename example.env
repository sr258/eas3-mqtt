# The UDP port at which EAS3 broadcasts are sent. Defaults to 45454
EAS3_BROADCAST_PORT=45454

# The local IP address the gateway listens on. Leave empty to listen on all
# network interfaces.
EAS3_BIND_ADDRESS=

# Comma-separated list of the IP addresses of the EAS 3 devices. If set,
# broadcasts from all other senders are ignored. Leave empty to accept
# broadcasts from every sender.
EAS3_ALLOWED_SOURCE_IPS=

# MQTT broker
MQTT_HOST=mqtthost
MQTT_PORT=1883
MQTT_USERNAME=mqtthostername
MQTT_PASSWORD=mqttpassword

# If true, the connection to the MQTT broker is encrypted with TLS (mqtts).
# MQTT_PORT then defaults to 8883.
MQTT_TLS=false

# Path to a CA certificate file (PEM) used to verify the broker's certificate.
# Only needed if the certificate isn't signed by a publicly trusted CA.
MQTT_CA_FILE=

# How often the gateway will publish autodiscovery messages to the MQTT broker.
# The gateway counts how many status broadcasts it receives per EAS 3 device
# and emits autodiscovery messages every X status broadcasts
# (X=MQTT_AUTODISCOVERY_FREQUENCY).
# Normally EAS 3 emits a status broadcast every five seconds, so this will be
# the same as "every X * 5 seconds".
# Examples:
# 1 = for every status broadcast
# 10 = every 10 status broadcasts (about every 50 seconds)
# Must be 1 or greater. Defaults to 10.
MQTT_AUTODISCOVERY_FREQUENCY=10

# If true, no autodiscovery messages will be sent to the MQTT broker.
MQTT_AUTODISCOVERY_DISABLED=false

# The prefix given to the devices in the MQTT broker. Defaults to eas3_
EAS3_MQTT_DEVICE_PREFIX=eas3_
